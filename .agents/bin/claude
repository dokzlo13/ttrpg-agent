#!/usr/bin/env bash
# Harness launcher: Claude Code, with the project environment contract applied.
#
# Claude does not need this launcher for Tier 2 — .claude/settings.json has a
# SessionStart hook that writes a `source .../.agents/env.sh` line into
# $CLAUDE_ENV_FILE, which Claude sources before every Bash call. This launcher
# exists for symmetry and so that `claude` started from anywhere still runs with
# the project root as cwd and the contract already applied to its own process.
set -uo pipefail

# Resolve this script through any symlinks BEFORE deriving the repo root.
# `ln -s <repo>/.agents/bin/qmd ~/.local/bin/qmd` would otherwise make
# dirname/../.. evaluate to /home, and env.sh would build the whole project
# skeleton there. Directory symlinks are handled by `cd`+`pwd -P`; this loop
# covers file symlinks.
_ttrpg_self="${BASH_SOURCE[0]}"
while [ -L "$_ttrpg_self" ]; do
  _ttrpg_link="$(readlink "$_ttrpg_self")"
  case "$_ttrpg_link" in
    /*) _ttrpg_self="$_ttrpg_link" ;;
    *) _ttrpg_self="$(dirname -- "$_ttrpg_self")/$_ttrpg_link" ;;
  esac
done
TTRPG_ROOT="$(cd -- "$(dirname -- "$_ttrpg_self")/../.." && pwd -P)"
unset _ttrpg_self _ttrpg_link
export TTRPG_ROOT
# A tool must never emit env.sh's KEY=VALUE dump on its own stdout; on
# .agents/bin/foundry-mcp that would corrupt the MCP JSON-RPC stream.
unset TTRPG_ENV_DUMP
# shellcheck disable=SC1091
source "$TTRPG_ROOT/.agents/env.sh"
cd "$TTRPG_ROOT" || exit 1

real_bin="$(_ttrpg_resolve_real_bin claude || true)"
if [ -z "$real_bin" ]; then
  printf 'claude: not found on PATH (excluding %s). Install Claude Code first.\n' \
    "$TTRPG_BIN_DIR" >&2
  exit 127
fi

exec "$real_bin" "$@"
