# Copy to .env and fill in. .env is gitignored; .env.example is checked in.
#
# Keep this file to simple KEY=value dotenv syntax. The project shell loads it
# before tools run, and individual CLIs also read it when invoked directly.
# Leave optional secret keys commented unless you want this project to override
# shell/global credentials.

# -----------------------------------------------------------------------------
# Web research / pi-web-access
# -----------------------------------------------------------------------------
# Optional. Exa may also work through MCP without a key; Gemini Web may work
# through browser login on supported systems. Project .env is sourced by
# .agents/env.sh before any tool runs, so uncommented values are visible to
# web tools and override shell/global values.
# EXA_API_KEY=
# PERPLEXITY_API_KEY=
# GEMINI_API_KEY=

# -----------------------------------------------------------------------------
# OpenAI-backed features
# -----------------------------------------------------------------------------
# Required for explicit image generation and for book-ingest Marker LLM modes
# other than TTRPG_MARKER_LLM_MODE=no. Metered.
# OPENAI_API_KEY=

# image-gen defaults. Used by the `generate_image` tool
# (.agents/cli/image-gen, reached via .agents/bin/generate-image);
# per-call tool params override these.
TTRPG_IMAGE_MODEL=gpt-image-1
TTRPG_IMAGE_SIZE=1024x1024
TTRPG_IMAGE_QUALITY=auto
TTRPG_IMAGE_OUTPUT_FORMAT=png
# Must remain under vault/notes/images for the image generation tool.
TTRPG_IMAGE_OUTPUT_DIR=vault/notes/images

# -----------------------------------------------------------------------------
# book-ingest / Marker LLM behavior
# -----------------------------------------------------------------------------
# Preferred setting: no | images-only | text-only | all
#   no          = fast local extraction, no API calls; image files still copied.
#   images-only = normal extraction + LLM captions for Picture/Figure blocks only.
#   text-only   = full Marker LLM cleanup, no image captions.
#   all         = full cleanup plus image captions.
TTRPG_MARKER_LLM_MODE=no
# Legacy fallback if TTRPG_MARKER_LLM_MODE is unset; normally leave commented.
# TTRPG_MARKER_USE_LLM=false
# TTRPG_MARKER_DESCRIBE_IMAGES=false
# OpenAI-compatible endpoint/model for Marker LLM calls.
TTRPG_MARKER_OPENAI_MODEL=gpt-5.6-luna
TTRPG_MARKER_OPENAI_BASE_URL=https://api.openai.com/v1
# Marker LLM parallel calls. 2 is a balanced default; use 1 if you still hit TPM
# limits, or 3+ if your account limits are high and imports are too slow.
TTRPG_MARKER_LLM_MAX_CONCURRENCY=2
# Minimum spacing between Marker LLM requests, in seconds. This is intentionally
# conservative to avoid noisy image-caption TPM rate-limit bursts.
TTRPG_MARKER_LLM_MIN_INTERVAL_SECONDS=2

# -----------------------------------------------------------------------------
# book-ingest / Marker local OCR-layout performance
# -----------------------------------------------------------------------------
# Optional. Override via book-ingest CLI flags. Device: auto | cuda | cpu | mps.
TTRPG_MARKER_DEVICE=auto
# Blank batch sizes let Marker choose. CUDA machines often do well with 8/8/128/8;
# lower these if you run out of VRAM.
TTRPG_MARKER_LAYOUT_BATCH_SIZE=
TTRPG_MARKER_DETECTION_BATCH_SIZE=
TTRPG_MARKER_RECOGNITION_BATCH_SIZE=
TTRPG_MARKER_TABLE_REC_BATCH_SIZE=

# -----------------------------------------------------------------------------
# qmd / embedding runtime overrides
# -----------------------------------------------------------------------------
# Usually leave these unset. .agents/env.sh sets project-local QMD_CONFIG_DIR
# and XDG_CACHE_HOME automatically. QMD_LLAMA_GPU is left UNSET so qmd 2.5+
# auto-selects a backend (a literal "auto" is actively unset by env.sh).
# QMD_LLAMA_GPU=false      # force CPU; any other value lets node-llama-cpp auto-pick
# QMD_CPU_FALLBACK=1       # retry selected qmd GPU failures once on CPU; set 0 to disable
# GGML_CUDA_NO_VMM=1       # WSL2/RTX workaround; .agents/env.sh defaults this to 1

# -----------------------------------------------------------------------------
# Cache isolation
# -----------------------------------------------------------------------------
# By default .agents/env.sh forces every cache project-local, UNCONDITIONALLY:
#
#   QMD_CONFIG_DIR   .cache/index       qmd index.yml
#   XDG_CACHE_HOME   .cache/xdg         qmd GGUFs (~2.2 GB), datalab/surya (~3.3 GB),
#                                       and the qmd index.sqlite
#   UV_CACHE_DIR     .cache/uv
#   HF_HOME          .cache/huggingface
#   TORCH_HOME       .cache/torch
#   npm_config_cache .cache/npm         (npm otherwise defaults to ~/.npm)
#
# Because they are unconditional, setting any of those keys HERE has no effect —
# that is deliberate, so an inherited shell value cannot silently break isolation.
# The single escape hatch, for anyone who genuinely wants to share a host cache:
# TTRPG_ALLOW_HOST_CACHES=1

# -----------------------------------------------------------------------------
# Foundry VTT MCP (TheStranjer/foundry-vtt-mcp)
# -----------------------------------------------------------------------------
# Create this user in the active Foundry world first. The launcher resolves the
# username to Foundry's internal user document ID on every MCP server start.
# FOUNDRY_MCP_USER=MCP
# FOUNDRY_MCP_PASSWORD=
# Use "auto" to discover the Windows host from WSL's current default route.
# In direct/native environments, use a hostname or IP such as "localhost".
FOUNDRY_MCP_HOST=auto
FOUNDRY_MCP_PORT=30000
# Required for the usual self-signed Foundry HTTPS certificate. Leave false
# when Foundry has a certificate trusted by WSL.
FOUNDRY_MCP_ALLOW_SELF_SIGNED=true
# Optional identity guards/overrides:
# FOUNDRY_MCP_WORLD=breathing-earth-5e
# FOUNDRY_MCP_USER_ID=68c7nTN2Ffga2i1p

# -----------------------------------------------------------------------------
# Optional WSL/Windows mirror sync
# -----------------------------------------------------------------------------
# When set, Pi conditionally exposes the ttrpg-wsl-sync skill. This should be a
# WSL path to a Windows-side Agent mirror root. Leave blank to hide the skill.
# Example: /mnt/c/path/to/Agent
TTRPG_WINDOWS_AGENT_DIR=

# -----------------------------------------------------------------------------
# craig-stt (Craig recording -> immutable transcription dataset)
# -----------------------------------------------------------------------------
# craig-stt takes its whole configuration from CRAIG_STT_* keys, nested with a
# double underscore (CRAIG_STT_<SECTION>__<FIELD>). Precedence is
# CLI > environment > .env > TOML > defaults, so anything .agents/env.sh exports
# beats a value set here.
#
# NOT here, deliberately: CRAIG_STT_CRAIG__KEY. The recording key is
# per-recording and lives in the share URL's `?key=` parameter — pass the whole
# URL. A persistent key is stale for every new recording, turns a forgotten
# `?key=` into a confusing 403, and .env is visible to every agent shell command.
#
# NOT here either: CRAIG_STT_WORK_DIR and CRAIG_STT_CACHE_DIR. Those decide where
# gigabytes land, so .agents/env.sh owns them and exports them unconditionally
# (.cache/sessions/datasets and .cache/craig-stt). Setting them here has no
# effect — same rule as the cache-isolation block above.
#
# Two parser notes, both real traps:
#   * .agents/env.sh strips a trailing ` # comment` from UNQUOTED values, exactly
#     as `source` used to. Quote any value that can contain a space followed by
#     `#` — JSON lists in particular. Single quotes keep JSON's double quotes
#     readable and are stripped by the parser.
#   * The stt.* section is extra="forbid" upstream: a misspelt CRAIG_STT_STT__*
#     key fails loudly instead of silently un-biasing a 10-minute GPU run. That
#     is a feature — do not "fix" a startup error by deleting the key.

# Self-hosted Craig (ferret) instance. Inferred from the share URL when unset.
# CRAIG_STT_CRAIG__BASE_URL=https://craig.example.com
# Exclude accounts Discord marks as bots (music bots, soundboards).
CRAIG_STT_CRAIG__IGNORE_BOTS=true
# Discord IDs or names to exclude, spelled as the recording page shows them.
# JSON list — keep the quotes so a `#` in a name cannot be eaten as a comment.
# CRAIG_STT_CRAIG__IGNORE_USERS='["123456789012345678", "Soundboard"]'
# A self-hosted Craig usually sits behind an internal CA or a self-signed cert.
# Prefer the CA bundle; verify_tls=false is the blunt escape hatch.
# CRAIG_STT_CRAIG__CA_BUNDLE=/etc/ssl/certs/internal-ca.pem
# CRAIG_STT_CRAIG__VERIFY_TLS=true

# Whisper. large-v3 is the quality baseline; the checkpoint (~3 GB) downloads on
# first use into .cache/craig-stt. task=translate would produce English instead
# of a Russian transcript — the pipeline expects transcribe.
CRAIG_STT_STT__MODEL=large-v3
CRAIG_STT_STT__LANGUAGE=ru
CRAIG_STT_STT__TASK=transcribe

# Cross-track bleed detection (one player's mic picking up another's voice).
# Defaults are usually right; raise bleed_delta_db if too much is flagged.
# CRAIG_STT_MERGE__DETECT_BLEED=true
# CRAIG_STT_MERGE__BLEED_DELTA_DB=9.0

# -----------------------------------------------------------------------------
# session-ingest (dataset -> transcript, recap draft, record.json)
# -----------------------------------------------------------------------------
# Post-processing knobs. All optional; these are the defaults, written out so a
# change is a visible edit rather than a hidden constant.

# Map-reduce extraction windows over the merged turn stream.
TTRPG_SESSION_WINDOW_MINUTES=15
TTRPG_SESSION_WINDOW_OVERLAP_PCT=10
# Gap between consecutive segments from one speaker before a new turn starts.
TTRPG_SESSION_MERGE_GAP_S=1.5
# Combined hotwords + initial_prompt budget handed to craig-stt by `plan`.
TTRPG_SESSION_GLOSSARY_BUDGET_CHARS=450

# Metered stages (segment / extract / recap / glossary). Without OPENAI_API_KEY
# they exit 0 with status "skipped" and drop out of the emitted next_steps.
TTRPG_SESSION_OPENAI_MODEL=gpt-5.6-luna
TTRPG_SESSION_OPENAI_MAX_CONCURRENCY=4

# QA thresholds. `qa` reports facts and which thresholds were crossed; it never
# renders a verdict, and crossing one is a prompt to consider a re-run, not an
# error. A retry costs GPU minutes and zero API spend.
TTRPG_SESSION_QA_MIN_WORD_P10=0.60
TTRPG_SESSION_QA_MAX_BLEED_RATE=0.10
TTRPG_SESSION_QA_MAX_LEXICON_MISS_RATE=0.35

# Echo detection for `qa --compare N`, not a threshold: nothing crosses it and it
# is in no cache key. When lexicon-term hits grow more than this many times faster
# than the transcript's word count, the comparison raises `term_hits_outran_words`
# — the fingerprint of a run that recited the biasing list instead of transcribing
# speech, which makes lexicon_miss_rate *fall* while the transcript gets worse.
TTRPG_SESSION_QA_ECHO_TERM_FACTOR=3.0
