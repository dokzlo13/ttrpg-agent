# --- local data -------------------------------------------------------------

# Working campaign vault and all user/imported/generated content. These are
# local runtime/data areas and may be real directories, symlinks, or absent
# until bootstrap/tooling recreates the expected structure.
vault
vault/
imports
imports/

# Single project-local cache root. Holds the rebuildable qmd config/index state
# (.cache/index, .cache/xdg/qmd), the expensive model stores (.cache/xdg/qmd/models,
# .cache/xdg/datalab, huggingface, torch), the uv/npm caches, and pinned vendor
# checkouts (.cache/vendor). Do not wipe during normal qmd/index cleanup — see
# ttrpg-system-data-cleanup for the per-subpath policy.
.cache/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Durable, gitignored agent state that is NOT a cache and must survive every
# cleanup scope — currently the Foundry MCP credential. Never commit this.
.agents/state/

# Trash directory (for manually deleted/moved files).
.trash/

# --- local pi/runtime caches ------------------------------------------------

.pi/npm/
.pi/git/
.pi-home/
# Runtime transcripts and artifacts emitted by the pi-subagents harness.
.pi-subagents/

# User-owned Claude Code permissions. Everything else under .claude/ is
# generated by `.agents/harness sync` and IS tracked; this one file is personal
# and must never be clobbered by the generator. (It was previously ignored only
# by a global ignore file, so it was ignored on one machine and not for anyone
# else.)
.claude/settings.local.json

# --- per-tool environments/build output ------------------------------------

**/.venv/
.venv/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
node_modules/
*.log

# --- editor / OS noise ------------------------------------------------------

.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~

# --- env & secrets ----------------------------------------------------------

.env
.env.*
!.env.example
